DATABASE_URL=postgresql://user:password@host:5432/dbname
# Render sets this automatically — do not set it manually there, only for local dev.
PORT=3000

# Must be a long, random string in production (e.g. `openssl rand -hex 32`). Used to sign GVMC official JWTs.
JWT_SECRET=changeme

# Supabase project settings -> API. SUPABASE_URL is the bare project URL (no /rest/v1
# or other path suffix) and SUPABASE_SERVICE_ROLE_KEY is the "service_role" secret key
# (not the anon/public key) — both required for photo uploads (/uploads).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme
SUPABASE_STORAGE_BUCKET=pothole-photos
