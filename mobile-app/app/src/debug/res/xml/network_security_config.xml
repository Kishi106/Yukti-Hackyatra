<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only: allows plain HTTP (cleartext) traffic so the app can talk to a
  locally-running backend (10.0.2.2 on the emulator, or a LAN IP on a real device)
  during development. This file lives under src/debug so it is never packaged into
  release builds, which stay HTTPS-only by Android's default network security policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
